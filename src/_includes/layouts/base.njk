<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and not homepage %}{{ title }} — Metro Studio{% else %}Metro Studio — Design studio, Newcastle{% endif %}</title>
<meta name="description" content="{{ description or 'Metro Studio is an independent design studio in Newcastle. Brand design, graphic design, web design, app development and analytics.' }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Metro Studio">
<meta property="og:title" content="{{ title or 'Metro Studio' }}">
<meta property="og:description" content="{{ description or 'Brands for businesses. Apps for everyone.' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% endif %}
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="icon" href="{{ favicon or '/favicon.svg' }}">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
{% include "partials/sprite.njk" %}
<a class="skip" href="#main">Skip to content</a>

{% include "partials/nav.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>
